  <!-- محرك النظام المالي والتفاعل المكتمل وزر التنزيل الفوري -->
  <script>
    const SECTORS_LIST = [
      { id: 'library', name: 'مكتبة الكنيسة والكتب', num: 1, icon: 'fa-book-bible', tag: 'مكتبات', cash: 0 },
      { id: 'buses', name: 'قطاع الأتوبيسات والرحلات', num: 2, icon: 'fa-bus', tag: 'رحلات ودير', cash: 0 },
      { id: 'farm', name: 'مزرعة بركة صموئيل للدواجن', num: 3, icon: 'fa-egg', tag: 'إنتاج داجني', cash: 0 },
      { id: 'garments', name: 'مصنع الملابس والتطريز', num: 4, icon: 'fa-shirt', tag: 'ملابس كهنوتية', cash: 0 },
      { id: 'canteen', name: 'كانتين الكنيسة وقاعة الضيافة', num: 5, icon: 'fa-mug-hot', tag: 'ضيافة', cash: 0 },
      { id: 'elderly', name: 'دار القديسين لرعاية المسنين', num: 6, icon: 'fa-person-walking', tag: 'رعاية ومسنين', cash: 0 },
      { id: 'special_needs', name: 'مركز الرجاء للاحتياجات', num: 7, icon: 'fa-hand-holding-heart', tag: 'رعاية خاصة', cash: 0 },
      { id: 'hall', name: 'قاعة المناسبات والاستقبالات', num: 8, icon: 'fa-champagne-glasses', tag: 'أفراح ومناسبات', cash: 0 }
    ];

    const STORE_KEY = 'church_samuel_v3_store';
    function getStore() {
      const saved = localStorage.getItem(STORE_KEY);
      if (saved) {
        try { return JSON.parse(saved); } catch(e) {}
      }
      return {
        activeSectorId: 'library',
        currentServant: 'الخادم المسؤول',
        sectors: {
          library: { cash: 0, items: [
            { id: 'it_lib_1', code: 'LIB-101', name: 'أجبية كبرى شمواه مذهبة', unit: 'نسخة', initQty: 50, currentQty: 50, costPrice: 45, sellPrice: 65 },
            { id: 'it_lib_2', code: 'LIB-102', name: 'كتاب السنكسار الجامع - مجلدين', unit: 'طقم', initQty: 25, currentQty: 25, costPrice: 280, sellPrice: 350 },
            { id: 'it_lib_3', code: 'LIB-103', name: 'بخور طبيعي معطر بالمسك', unit: 'علبة', initQty: 100, currentQty: 100, costPrice: 40, sellPrice: 60 }
          ]},
          buses: { cash: 0, items: [
            { id: 'it_bus_1', code: 'BUS-201', name: 'تذكرة رحلة دير الأنبا صموئيل', unit: 'تذكرة', initQty: 200, currentQty: 200, costPrice: 50, sellPrice: 50 }
          ]},
          farm: { cash: 0, items: [
            { id: 'it_frm_1', code: 'FRM-301', name: 'كرتونة بيض مائدة أحمر سوبر', unit: 'كرتونة', initQty: 400, currentQty: 400, costPrice: 130, sellPrice: 150 },
            { id: 'it_frm_2', code: 'FRM-302', name: 'دواجن تسمين مجمدة 1200 جم', unit: 'دجاجة', initQty: 180, currentQty: 180, costPrice: 85, sellPrice: 105 }
          ]},
          garments: { cash: 0, items: [
            { id: 'it_gar_1', code: 'GAR-401', name: 'تونية شماس كتان مطرزة', unit: 'تونية', initQty: 60, currentQty: 60, costPrice: 110, sellPrice: 160 }
          ]},
          canteen: { cash: 0, items: [
            { id: 'it_can_1', code: 'CAN-501', name: 'وجبة إفطار صيامية متكاملة', unit: 'وجبة', initQty: 150, currentQty: 150, costPrice: 15, sellPrice: 25 }
          ]},
          elderly: { cash: 0, items: [
            { id: 'it_eld_1', code: 'ELD-601', name: 'مساهمة شهرية رعاية مسن', unit: 'سهم', initQty: 100, currentQty: 100, costPrice: 100, sellPrice: 100 }
          ]},
          special_needs: { cash: 0, items: [
            { id: 'it_spc_1', code: 'SPC-701', name: 'جلسة علاج طبيعي وتخاطب', unit: 'جلسة', initQty: 80, currentQty: 80, costPrice: 50, sellPrice: 50 }
          ]},
          hall: { cash: 0, items: [
            { id: 'it_hal_1', code: 'HAL-801', name: 'حجز قاعة مناسبات (فترة مسائية)', unit: 'حجز', initQty: 30, currentQty: 30, costPrice: 500, sellPrice: 1200 }
          ]}
        },
        transactions: []
      };
    }

    let state = getStore();

    function saveStore() {
      localStorage.setItem(STORE_KEY, JSON.stringify(state));
      renderAll();
    }

    // تنزيل ملف الكود كاملاً ومباشرة
    window.downloadSelf = function() {
      const fullHtml = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
      const blob = new Blob([fullHtml], { type: 'text/html;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'index.html';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(a.href);
      alert('تم بنجاح تنزيل ملف index.html كاملاً إلى جهازك!');
    };

    window.toggleView = function(view) {
      document.getElementById('login-view').classList.toggle('hidden', view !== 'login');
      document.getElementById('dashboard-view').classList.toggle('hidden', view !== 'dashboard');
    };

    window.handleLogin = function(e) {
      e.preventDefault();
      const name = document.getElementById('login-name').value;
      const sector = document.getElementById('login-sector').value;
      state.currentServant = name;
      if (sector !== 'all' && state.sectors[sector]) {
        state.activeSectorId = sector;
      }
      document.getElementById('current-servant-name').innerText = name;
      saveStore();
      toggleView('dashboard');
    };

    window.selectSector = function(sectorId) {
      if (!state.sectors[sectorId]) return;
      state.activeSectorId = sectorId;
      document.getElementById('modal-item-sector').value = sectorId;
      saveStore();
    };

    let currentTab = 'items';
    window.switchTab = function(tabKey) {
      currentTab = tabKey;
      const tabs = ['items', 'invoice', 'purchase', 'treasury', 'reports'];
      tabs.forEach(t => {
        const btn = document.getElementById('btn-tab-' + t);
        const content = document.getElementById('tab-content-' + t);
        if (t === tabKey) {
          btn.classList.add('action-btn-active');
          content.classList.remove('hidden');
        } else {
          btn.classList.remove('action-btn-active');
          content.classList.add('hidden');
        }
      });
      if (tabKey === 'invoice') populateInvoiceItems();
      if (tabKey === 'purchase') populatePurchaseItems();
    };

    function renderSectorsCards() {
      const container = document.getElementById('sectors-cards-container');
      container.innerHTML = SECTORS_LIST.map(sec => {
        const data = state.sectors[sec.id] || { cash: 0, items: [] };
        const isActive = (sec.id === state.activeSectorId);
        return `
          <div onclick="selectSector('${sec.id}')" 
               class="cursor-pointer bg-slate-900 border rounded-2xl p-2.5 sm:p-3 text-center transition card-hover ${isActive ? 'sector-btn-active' : 'border-slate-800 hover:border-slate-700'}">
            <div class="w-8 h-8 mx-auto rounded-xl ${isActive ? 'bg-blue-600 text-white' : 'bg-slate-800 text-slate-300'} flex items-center justify-center text-xs mb-1.5 shadow-sm">
              <i class="fa-solid ${sec.icon}"></i>
            </div>
            <h4 class="font-bold text-xs text-white truncate">${sec.name}</h4>
            <div class="text-[10px] text-slate-400 mt-0.5">${(data.items || []).length} صنف</div>
            <div class="text-xs font-black text-emerald-400 font-mono mt-1">${(data.cash || 0).toLocaleString()} ج.م</div>
          </div>
        `;
      }).join('');
    }

    function renderItemsTable() {
      const tbody = document.getElementById('items-table-body');
      const secData = state.sectors[state.activeSectorId];
      if (!secData || !secData.items || secData.items.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" class="p-6 text-center text-slate-500 text-xs">لا توجد أصناف مسجلة لهذا القسم حالياً. اضغط "إضافة صنف جديد" بالزر الأصفر بالأعلى للبدء.</td></tr>`;
        return;
      }
      tbody.innerHTML = secData.items.map((it, idx) => `
        <tr class="hover:bg-slate-900/50 transition">
          <td class="p-2.5 font-mono text-slate-400 font-bold">${it.code || 'ITM-' + (idx+1)}</td>
          <td class="p-2.5 font-bold text-slate-100">${it.name}</td>
          <td class="p-2.5 text-slate-400">${it.unit || 'قطعة'}</td>
          <td class="p-2.5 font-bold text-slate-300">${it.initQty || 0}</td>
          <td class="p-2.5 font-black ${(it.currentQty <= 5) ? 'text-rose-400' : 'text-emerald-400'}">${it.currentQty}</td>
          <td class="p-2.5 text-slate-300 font-mono">${(it.costPrice || 0).toLocaleString()} ج.م</td>
          <td class="p-2.5 font-bold text-blue-400 font-mono">${(it.sellPrice || 0).toLocaleString()} ج.م</td>
          <td class="p-2.5 text-center">
            <button onclick="deleteItem(${idx})" title="حذف الصنف" class="text-rose-400 hover:text-rose-300 p-1">
              <i class="fa-solid fa-trash-can"></i>
            </button>
          </td>
        </tr>
      `).join('');
    }

    window.deleteItem = function(idx) {
      const secData = state.sectors[state.activeSectorId];
      if (confirm(`هل ترغب في حذف الصنف (${secData.items[idx].name}) من مخزن القسم؟`)) {
        secData.items.splice(idx, 1);
        saveStore();
      }
    };

    function populateInvoiceItems() {
      const sel = document.getElementById('invoice-item-select');
      const secData = state.sectors[state.activeSectorId];
      const secInfo = SECTORS_LIST.find(s => s.id === state.activeSectorId);
      document.getElementById('inv-active-sec-name').innerText = secInfo ? secInfo.name : '';

      if (!secData || !secData.items || secData.items.length === 0) {
        sel.innerHTML = '<option value="">لا توجد أصناف في هذا القسم</option>';
        document.getElementById('invoice-price').value = 0;
        calculateInvoiceTotal();
        return;
      }
      sel.innerHTML = secData.items.map(it => `
        <option value="${it.id}">${it.name} (المتاح: ${it.currentQty} ${it.unit})</option>
      `).join('');
      autoFillInvoicePrice();
    }

    window.autoFillInvoicePrice = function() {
      const itemId = document.getElementById('invoice-item-select').value;
      const secData = state.sectors[state.activeSectorId];
      const it = secData.items.find(i => i.id === itemId);
      if (it) {
        document.getElementById('invoice-price').value = it.sellPrice || 0;
      }
      calculateInvoiceTotal();
    };

    window.calculateInvoiceTotal = function() {
      const qty = Number(document.getElementById('invoice-qty').value) || 0;
      const price = Number(document.getElementById('invoice-price').value) || 0;
      const disc = Number(document.getElementById('invoice-discount').value) || 0;
      const total = Math.max(0, (qty * price) - disc);
      document.getElementById('invoice-total-display').innerText = total.toLocaleString() + ' ج.م';
    };

    window.handleInvoiceSubmit = function(e) {
      e.preventDefault();
      const itemId = document.getElementById('invoice-item-select').value;
      const qty = Number(document.getElementById('invoice-qty').value) || 1;
      const price = Number(document.getElementById('invoice-price').value) || 0;
      const disc = Number(document.getElementById('invoice-discount').value) || 0;
      const total = Math.max(0, (qty * price) - disc);

      const secData = state.sectors[state.activeSectorId];
      const secInfo = SECTORS_LIST.find(s => s.id === state.activeSectorId);
      const it = secData.items.find(i => i.id === itemId);

      if (!it) {
        alert('يرجى اختيار صنف صحيح من القائمة.');
        return;
      }
      if (it.currentQty < qty) {
        alert(`المخزون المتوفر (${it.currentQty}) غير كافٍ لتسجيل بيع (${qty})!`);
        return;
      }

      it.currentQty -= qty;
      secData.cash = (secData.cash || 0) + total;

      state.transactions.unshift({
        id: 'INV-' + Date.now().toString().slice(-5),
        sectorId: state.activeSectorId,
        sectorName: secInfo.name,
        date: new Date().toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' }) + ' ' + new Date().toLocaleDateString('ar-EG'),
        desc: `فاتورة بيع: ${it.name} (عدد ${qty} ${it.unit})` + (disc > 0 ? ` [خصم ${disc} ج.م]` : ''),
        type: 'مبيعات (قبض)',
        amount: total,
        officer: state.currentServant || 'الخادم المسؤول'
      });

      saveStore();
      alert(`تم بنجاح ترحيل الفاتورة بقيمة ${total.toLocaleString()} ج.م! تم خصم ${qty} من المخزون وإضافتها لخزينة (${secInfo.name}).`);
      populateInvoiceItems();
    };

    function populatePurchaseItems() {
      const sel = document.getElementById('purchase-item-select');
      const secData = state.sectors[state.activeSectorId];
      if (!secData || !secData.items || secData.items.length === 0) {
        sel.innerHTML = '<option value="">لا توجد أصناف، أضف صنفاً أولاً</option>';
        return;
      }
      sel.innerHTML = secData.items.map(it => `
        <option value="${it.id}">${it.name} (المخزون الحالي: ${it.currentQty})</option>
      `).join('');
    }

    window.handlePurchaseSubmit = function(e) {
      e.preventDefault();
      const itemId = document.getElementById('purchase-item-select').value;
      const qty = Number(document.getElementById('purchase-qty').value) || 0;
      const cost = Number(document.getElementById('purchase-cost').value) || 0;
      const supplier = document.getElementById('purchase-supplier').value || 'مورد عام';

      const secData = state.sectors[state.activeSectorId];
      const secInfo = SECTORS_LIST.find(s => s.id === state.activeSectorId);
      const it = secData.items.find(i => i.id === itemId);

      if (!it) {
        alert('يرجى اختيار صنف للتوريد');
        return;
      }

      it.currentQty += qty;
      it.costPrice = cost;

      state.transactions.unshift({
        id: 'SUP-' + Date.now().toString().slice(-5),
        sectorId: state.activeSectorId,
        sectorName: secInfo.name,
        date: new Date().toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' }) + ' ' + new Date().toLocaleDateString('ar-EG'),
        desc: `توريد للمخزن: ${it.name} (إضافة ${qty} من ${supplier})`,
        type: 'توريد مخزني',
        amount: qty * cost,
        officer: state.currentServant || 'الخادم المسؤول'
      });

      saveStore();
      alert(`تم بنجاح إيداع ${qty} ${it.unit} في مخزن (${secInfo.name})! أصبح المخزون الحالي: ${it.currentQty}.`);
      populatePurchaseItems();
      e.target.reset();
    };

    function renderTreasuryTable() {
      const tbody = document.getElementById('treasury-table-body');
      const txs = state.transactions.filter(t => t.sectorId === state.activeSectorId);
      if (txs.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-slate-500 text-xs">لا توجد حركات نقدية مسجلة لخزينة هذا القسم بعد.</td></tr>`;
        return;
      }
      tbody.innerHTML = txs.map(tx => {
        const isExpense = tx.type.includes('صرف') || tx.type.includes('مصروف');
        return `
          <tr class="hover:bg-slate-900/50 transition">
            <td class="p-2.5 font-mono text-slate-400 font-bold">${tx.id}</td>
            <td class="p-2.5 text-slate-400">${tx.date}</td>
            <td class="p-2.5 font-bold text-slate-100">${tx.desc}</td>
            <td class="p-2.5">
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${isExpense ? 'bg-rose-500/20 text-rose-300' : 'bg-emerald-500/20 text-emerald-300'}">
                ${tx.type}
              </span>
            </td>
            <td class="p-2.5 font-mono font-bold ${isExpense ? 'text-rose-400' : 'text-emerald-400'}">
              ${isExpense ? '-' : '+'}${tx.amount.toLocaleString()} ج.م
            </td>
            <td class="p-2.5 text-slate-300">${tx.officer}</td>
          </tr>
        `;
      }).join('');
    }

    window.promptTreasuryPayment = function() {
      const secData = state.sectors[state.activeSectorId];
      const secInfo = SECTORS_LIST.find(s => s.id === state.activeSectorId);
      const desc = prompt(`تسجيل سند صرف / مصروف لقسم (${secInfo.name}):\nاكتب بيان المصروف:`);
      if (!desc) return;
      const amt = parseFloat(prompt('أدخل المبلغ المصروف (ج.م):', '100'));
      if (isNaN(amt) || amt <= 0) return;

      secData.cash = Math.max(0, (secData.cash || 0) - amt);

      state.transactions.unshift({
        id: 'PAY-' + Date.now().toString().slice(-5),
        sectorId: state.activeSectorId,
        sectorName: secInfo.name,
        date: new Date().toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' }) + ' ' + new Date().toLocaleDateString('ar-EG'),
        desc: `سند صرف: ${desc}`,
        type: 'مصروف (صرف)',
        amount: amt,
        officer: state.currentServant || 'الخادم المسؤول'
      });

      saveStore();
      alert(`تم تسجيل سند الصرف بقيمة ${amt.toLocaleString()} ج.م وخصمه من خزينة القسم.`);
    };

    window.closeTreasuryPeriod = function() {
      const secData = state.sectors[state.activeSectorId];
      const secInfo = SECTORS_LIST.find(s => s.id === state.activeSectorId);
      const reportId = 'CLS-' + Date.now().toString().slice(-4);
      alert(`[محضر تقفيل خزينة القسم]\nالقسم: ${secInfo.name}\nرقم المحضر: ${reportId}\nالرصيد النقدي الفعلي المعتمد: ${(secData.cash || 0).toLocaleString()} ج.م\nالخادم المسؤول: ${state.currentServant}\nتم تثبيت الرصيد وترحيله للمراجعة المالية بنجاح.`);
    };

    function renderReportsTable() {
      const tbody = document.getElementById('reports-table-body');
      tbody.innerHTML = SECTORS_LIST.map((sec, idx) => {
        const d = state.sectors[sec.id] || { cash: 0, items: [] };
        return `
          <tr class="hover:bg-slate-900/50 transition">
            <td class="p-2.5 font-mono text-slate-500">${idx + 1}</td>
            <td class="p-2.5 font-bold text-slate-100 flex items-center gap-1.5">
              <i class="fa-solid ${sec.icon} text-blue-400 text-xs"></i>
              <span>${sec.name}</span>
            </td>
            <td class="p-2.5 font-mono font-bold text-emerald-400">${(d.cash || 0).toLocaleString()} ج.م</td>
            <td class="p-2.5 font-bold text-slate-300">${(d.items || []).length} صنف</td>
            <td class="p-2.5"><span class="text-[10px] bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded-full font-bold">مطابق 100%</span></td>
          </tr>
        `;
      }).join('');
    }

    window.openModal = (id) => document.getElementById(id).classList.remove('hidden');
    window.closeModal = (id) => document.getElementById(id).classList.add('hidden');

    window.handleAddNewItem = function(e) {
      e.preventDefault();
      const secId = document.getElementById('modal-item-sector').value;
      const name = document.getElementById('modal-item-name').value;
      const unit = document.getElementById('modal-item-unit').value || 'قطعة';
      const qty = Number(document.getElementById('modal-item-qty').value) || 0;
      const cost = Number(document.getElementById('modal-item-cost').value) || 0;
      const price = Number(document.getElementById('modal-item-price').value) || 0;

      if (!state.sectors[secId]) state.sectors[secId] = { cash: 0, items: [] };
      const sec = state.sectors[secId];
      sec.items.push({
        id: 'it_' + Date.now(),
        code: secId.slice(0, 3).toUpperCase() + '-' + (sec.items.length + 101),
        name,
        unit,
        initQty: qty,
        currentQty: qty,
        costPrice: cost,
        sellPrice: price
      });

      closeModal('add-item-modal');
      e.target.reset();
      saveStore();
      alert(`تمت إضافة الصنف (${name}) بنجاح إلى مخزن القسم!`);
    };

    function renderAll() {
      const activeSecInfo = SECTORS_LIST.find(s => s.id === state.activeSectorId) || SECTORS_LIST[0];
      const activeSecData = state.sectors[state.activeSectorId] || { cash: 0, items: [] };

      document.getElementById('active-sec-title').innerText = activeSecInfo.name;
      document.getElementById('active-sec-icon').className = 'fa-solid ' + activeSecInfo.icon;
      document.getElementById('active-sec-cash').innerText = (activeSecData.cash || 0).toLocaleString() + ' ج.م';
      document.getElementById('active-sec-items-count').innerText = (activeSecData.items || []).length + ' صنف';

      let totalCash = 0;
      let totalRev = 0;
      let totalItems = 0;

      for (const [key, val] of Object.entries(state.sectors)) {
        totalCash += (val.cash || 0);
        totalItems += (val.items ? val.items.length : 0);
      }
      state.transactions.forEach(t => {
        if (t.type.includes('قبض') || t.type.includes('مبيعات')) totalRev += t.amount;
      });

      document.getElementById('total-cash').innerText = totalCash.toLocaleString() + ' ج.م';
      document.getElementById('total-revenue').innerText = totalRev.toLocaleString() + ' ج.م';
      document.getElementById('total-items-count').innerText = totalItems + ' صنف';

      renderSectorsCards();
      renderItemsTable();
      renderTreasuryTable();
      renderReportsTable();
      switchTab(currentTab);
    }

    window.addEventListener('DOMContentLoaded', () => {
      document.getElementById('current-servant-name').innerText = state.currentServant || 'الخادم المسؤول';
      renderAll();
    });
  </script>
</body>
</html>
