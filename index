<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>النظام المالي والمحاسبي الموحد - كنيسة الأنبا صموئيل المعترف</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=Noto+Sans+Arabic:wght@400;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0f172a">

  <style>
    body { font-family: 'Cairo', 'Noto Sans Arabic', sans-serif; background-color: #0b1120; }
    .card-hover { transition: all 0.25s ease; }
    .card-hover:hover { transform: translateY(-3px); }
    .sector-btn-active { border-color: #3b82f6 !important; background-color: rgba(30, 58, 138, 0.4) !important; box-shadow: 0 0 15px rgba(59, 130, 246, 0.3); }
    .action-btn-active { background: linear-gradient(135deg, #2563eb, #1d4ed8) !important; color: #ffffff !important; border-color: #60a5fa !important; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4); }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen antialiased flex flex-col justify-between selection:bg-blue-600 selection:text-white">

  <!-- شريط تثبيت التطبيق وتنزيل ملفات النظام -->
  <div class="bg-blue-600 text-white px-4 py-2.5 text-xs sm:text-sm flex flex-wrap items-center justify-between gap-2 shadow-lg">
    <div class="flex items-center gap-2">
      <i class="fa-solid fa-cloud-arrow-down text-amber-300 text-base"></i>
      <span class="font-bold">حزمة النظام المالي الكاملة لكنيسة الأنبا صموئيل المعترف (جاهزة للتشغيل المباشر)</span>
    </div>
    <div class="flex items-center gap-2">
      <button onclick="downloadSelf()" class="bg-amber-400 hover:bg-amber-300 text-slate-950 font-black px-3.5 py-1.5 rounded-lg text-xs shadow flex items-center gap-1.5 transition">
        <i class="fa-solid fa-download"></i>
        <span>تحميل ملف index.html الآن</span>
      </button>
    </div>
  </div>

  <!-- رأس الصفحة العلوي (Header) -->
  <header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-40 px-4 lg:px-8 py-3">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-400 text-xl font-bold shadow-inner">
          <i class="fa-solid fa-church"></i>
        </div>
        <div>
          <h1 class="text-sm sm:text-base font-black tracking-tight text-white flex items-center gap-2">
            كنيسة القديس الأنبا صموئيل المعترف
            <span class="text-[10px] bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 px-2 py-0.5 rounded-full font-bold">
              متصل ⚡
            </span>
          </h1>
          <p class="text-[11px] text-slate-400">منظومة الحسابات والمخزون الموحدة للأقسام الثمانية</p>
        </div>
      </div>

      <!-- معلومات الخادم النشط وزر التبديل والتحميل -->
      <div class="flex items-center gap-2">
        <button onclick="downloadSelf()" class="hidden sm:flex bg-slate-800 hover:bg-slate-700 text-amber-300 border border-amber-500/30 px-3 py-1.5 rounded-lg text-xs font-bold items-center gap-1.5 transition">
          <i class="fa-solid fa-file-arrow-down"></i>
          <span>حفظ نسخة للموبايل</span>
        </button>
        <button onclick="toggleView('login')" class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs text-slate-300 flex items-center gap-1.5 transition" title="تبديل الخادم">
          <i class="fa-solid fa-user-gear text-amber-400"></i>
          <span id="current-servant-name">الخادم المسؤول</span>
        </button>
      </div>
    </div>
  </header>

  <!-- 1. شاشة تسجيل الدخول / تبديل الخادم -->
  <main id="login-view" class="hidden flex-1 flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl text-right">
      <div class="text-center mb-6">
        <div class="w-14 h-14 bg-gradient-to-tr from-amber-600 to-amber-400 rounded-2xl mx-auto flex items-center justify-center text-2xl text-slate-950 font-black shadow-lg shadow-amber-500/20 mb-3">
          <i class="fa-solid fa-cross"></i>
        </div>
        <h2 class="text-lg font-black text-white">تسجيل خادم / أمين عهدة</h2>
        <p class="text-xs text-slate-400 mt-1">كنيسة القديس الأنبا صموئيل المعترف</p>
      </div>

      <form onsubmit="handleLogin(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-300 mb-1">اسم الخادم ثلاثي</label>
          <input type="text" id="login-name" required placeholder="مثال: ميخائيل جورج فرج" 
                 class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-slate-100 placeholder-slate-600 focus:outline-none focus:border-amber-500">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-300 mb-1">رقم الهاتف (WhatsApp)</label>
          <input type="tel" id="login-phone" required placeholder="01xxxxxxxxx" dir="ltr"
                 class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-slate-100 placeholder-slate-600 focus:outline-none focus:border-amber-500 text-left">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-300 mb-1">القسم المسؤول عنه</label>
          <select id="login-sector" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2.5 text-xs text-slate-200 focus:outline-none focus:border-amber-500">
            <option value="library">1. مكتبة الكنيسة ومنافذ بيع الكتب</option>
            <option value="buses">2. قطاع الأتوبيسات والرحلات الديرية</option>
            <option value="farm">3. مزرعة بركة صموئيل للدواجن والبيض</option>
            <option value="garments">4. مصنع وتطريز الملابس الكنسية</option>
            <option value="canteen">5. كانتين الكنيسة وقاعة الضيافة</option>
            <option value="elderly">6. دار القديسين لرعاية المسنين</option>
            <option value="special_needs">7. مركز الرجاء لذوي الاحتياجات الخاصة</option>
            <option value="hall">8. قاعة المناسبات واستقبالات الأفراح</option>
            <option value="all">كافة الأقسام (أمين الصندوق العام / مشرف)</option>
          </select>
        </div>
        <button type="submit" class="w-full bg-amber-500 hover:bg-amber-400 text-slate-950 font-black py-2.5 rounded-xl text-xs flex items-center justify-center gap-2 shadow-lg transition">
          <i class="fa-solid fa-right-to-bracket"></i>
          دخول لوحة التحكم والبدء
        </button>
      </form>
    </div>
  </main>

  <!-- 2. لوحة التحكم التفاعلية الكبرى (Dashboard) -->
  <main id="dashboard-view" class="flex-1 max-w-7xl mx-auto w-full px-4 lg:px-8 py-5 space-y-6">

    <!-- كروت إجمالي المؤشرات المالية العامة -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-lg relative overflow-hidden">
        <div class="text-xs font-bold text-slate-400 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          إجمالي أرصدة الخزائن (نقدية)
        </div>
        <div id="total-cash" class="text-2xl font-black text-emerald-400 mt-1">0 ج.م</div>
        <div class="text-[10px] text-slate-500 mt-0.5">محدثة لحظياً لكافة الخزائن</div>
      </div>
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-lg relative overflow-hidden">
        <div class="text-xs font-bold text-slate-400 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-blue-400"></span>
          إجمالي الإيرادات والمبيعات
        </div>
        <div id="total-revenue" class="text-2xl font-black text-blue-400 mt-1">0 ج.م</div>
        <div class="text-[10px] text-slate-500 mt-0.5">إجمالي الحركات الصادرة والواردة</div>
      </div>
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-lg relative overflow-hidden">
        <div class="text-xs font-bold text-slate-400 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span>
          عدد الأصناف المسجلة
        </div>
        <div id="total-items-count" class="text-2xl font-black text-amber-400 mt-1">0 صنف</div>
        <div class="text-[10px] text-slate-500 mt-0.5">إجمالي المخزون في الأقسام الثمانية</div>
      </div>
    </div>

    <!-- شريط الأقسام الثمانية -->
    <section>
      <div class="flex items-center justify-between mb-2.5">
        <h3 class="text-xs sm:text-sm font-bold text-slate-200 flex items-center gap-2">
          <i class="fa-solid fa-layer-group text-blue-400"></i>
          <span>أقسام الكنيسة الثمانية (اضغط على أي قسم لفتح لوحته وأصنافه)</span>
        </h3>
        <span class="text-[11px] text-slate-400">القسم المختار يحدد العمليات بالأسفل</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2" id="sectors-cards-container"></div>
    </section>

    <!-- بطاقة القسم النشط والأدوات التشغيلية الخمس -->
    <section class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-6 shadow-xl space-y-5">
      
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-800 gap-3">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-blue-600/20 text-blue-400 border border-blue-500/30 flex items-center justify-center text-xl">
            <i id="active-sec-icon" class="fa-solid fa-book-bible"></i>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] bg-blue-500/20 text-blue-400 border border-blue-500/30 px-2 py-0.5 rounded-full font-bold">القسم النشط حالياً</span>
              <h2 id="active-sec-title" class="text-base sm:text-lg font-black text-white">مكتبة الكنيسة ومنافذ بيع الكتب</h2>
            </div>
            <div class="text-xs text-slate-400 mt-0.5">
              خزينة القسم الحالية: <span id="active-sec-cash" class="font-bold text-emerald-400 font-mono">0 ج.م</span>
              <span class="mx-1.5 text-slate-600">•</span>
              الأصناف المتوفرة: <span id="active-sec-items-count" class="font-bold text-slate-200">0 صنف</span>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button onclick="openModal('add-item-modal')" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-3 py-2 rounded-xl text-xs flex items-center gap-1.5 shadow transition">
            <i class="fa-solid fa-plus-circle"></i>
            <span>إضافة صنف جديد</span>
          </button>
        </div>
      </div>

      <!-- الأيقونات التشغيلية الخمس -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5">
        <button onclick="switchTab('items')" id="btn-tab-items" class="action-btn p-3 rounded-xl border border-slate-700 bg-slate-950 text-right transition flex flex-col justify-between h-20 text-slate-200 hover:border-blue-500">
          <div class="flex items-center justify-between">
            <span class="w-7 h-7 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center text-xs"><i class="fa-solid fa-boxes-stacked"></i></span>
            <span class="text-[10px] font-bold text-slate-500">1</span>
          </div>
          <div>
            <div class="text-xs font-black">الأصناف ورصيد أول المدة</div>
            <div class="text-[10px] text-slate-400">إدخال، جرد، وتعديل</div>
          </div>
        </button>

        <button onclick="switchTab('invoice')" id="btn-tab-invoice" class="action-btn p-3 rounded-xl border border-slate-700 bg-slate-950 text-right transition flex flex-col justify-between h-20 text-slate-200 hover:border-emerald-500">
          <div class="flex items-center justify-between">
            <span class="w-7 h-7 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xs"><i class="fa-solid fa-file-invoice-dollar"></i></span>
            <span class="text-[10px] font-bold text-slate-500">2</span>
          </div>
          <div>
            <div class="text-xs font-black">تسجيل فاتورة بيع جديدة</div>
            <div class="text-[10px] text-slate-400">خصم المخزون والإيراد</div>
          </div>
        </button>

        <button onclick="switchTab('purchase')" id="btn-tab-purchase" class="action-btn p-3 rounded-xl border border-slate-700 bg-slate-950 text-right transition flex flex-col justify-between h-20 text-slate-200 hover:border-indigo-500">
          <div class="flex items-center justify-between">
            <span class="w-7 h-7 rounded-lg bg-indigo-500/20 text-indigo-400 flex items-center justify-center text-xs"><i class="fa-solid fa-cart-flatbed"></i></span>
            <span class="text-[10px] font-bold text-slate-500">3</span>
          </div>
          <div>
            <div class="text-xs font-black">شراء وتوريد أصناف</div>
            <div class="text-[10px] text-slate-400">إيداع وزيادة المخزون</div>
          </div>
        </button>

        <button onclick="switchTab('treasury')" id="btn-tab-treasury" class="action-btn p-3 rounded-xl border border-slate-700 bg-slate-950 text-right transition flex flex-col justify-between h-20 text-slate-200 hover:border-amber-500">
          <div class="flex items-center justify-between">
            <span class="w-7 h-7 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center text-xs"><i class="fa-solid fa-vault"></i></span>
            <span class="text-[10px] font-bold text-slate-500">4</span>
          </div>
          <div>
            <div class="text-xs font-black">الخزينة وحركات النقدية</div>
            <div class="text-[10px] text-slate-400">كشف حساب وتقفيل</div>
          </div>
        </button>

        <button onclick="switchTab('reports')" id="btn-tab-reports" class="action-btn p-3 rounded-xl border border-slate-700 bg-slate-950 text-right transition flex flex-col justify-between h-20 text-slate-200 hover:border-rose-500">
          <div class="flex items-center justify-between">
            <span class="w-7 h-7 rounded-lg bg-rose-500/20 text-rose-400 flex items-center justify-center text-xs"><i class="fa-solid fa-chart-pie"></i></span>
            <span class="text-[10px] font-bold text-slate-500">5</span>
          </div>
          <div>
            <div class="text-xs font-black">التقارير الشاملة</div>
            <div class="text-[10px] text-slate-400">أصناف وخزائن ومراجعة</div>
          </div>
        </button>
      </div>

      <!-- مساحة المحتوى التشغيلي -->
      <div class="bg-slate-950/80 rounded-xl p-4 sm:p-5 border border-slate-800">

        <!-- 1. تبويب الأصناف -->
        <div id="tab-content-items" class="space-y-4">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <div>
              <h4 class="text-xs sm:text-sm font-bold text-white flex items-center gap-1.5">
                <i class="fa-solid fa-boxes-stacked text-blue-400"></i>
                <span>قائمة أصناف ومخزون القسم المختار</span>
              </h4>
              <p class="text-[11px] text-slate-400">تعديل رصيد أول المدة وسعر البيع والتكلفة وحذف الأصناف</p>
            </div>
            <button onclick="openModal('add-item-modal')" class="bg-blue-600 hover:bg-blue-500 text-white font-bold px-3 py-1.5 rounded-lg text-xs flex items-center gap-1 transition">
              <i class="fa-solid fa-plus"></i>
              <span>إضافة صنف لهذا القسم</span>
            </button>
          </div>

          <div class="overflow-x-auto border border-slate-800 rounded-xl">
            <table class="w-full text-right text-xs">
              <thead class="bg-slate-900 text-slate-400 border-b border-slate-800">
                <tr>
                  <th class="p-2.5">الكود</th>
                  <th class="p-2.5">اسم الصنف</th>
                  <th class="p-2.5">الوحدة</th>
                  <th class="p-2.5">رصيد أول المدة</th>
                  <th class="p-2.5">المتاح حالياً</th>
                  <th class="p-2.5">سعر التكلفة</th>
                  <th class="p-2.5">سعر البيع</th>
                  <th class="p-2.5 text-center">إجراء</th>
                </tr>
              </thead>
              <tbody id="items-table-body" class="divide-y divide-slate-850"></tbody>
            </table>
          </div>
        </div>

        <!-- 2. تبويب فاتورة بيع -->
        <div id="tab-content-invoice" class="hidden space-y-4">
          <div>
            <h4 class="text-xs sm:text-sm font-bold text-white flex items-center gap-1.5">
              <i class="fa-solid fa-file-invoice-dollar text-emerald-400"></i>
              <span>إنشاء فاتورة مبيعات جديدة لـ: <span id="inv-active-sec-name" class="text-emerald-400"></span></span>
            </h4>
            <p class="text-[11px] text-slate-400">خصم الكمية من المخزون فوراً وزيادة رصيد خزينة القسم</p>
          </div>

          <form onsubmit="handleInvoiceSubmit(event)" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 bg-slate-900/60 p-4 rounded-xl border border-slate-800">
            <div>
              <label class="block text-xs text-slate-300 font-semibold mb-1">اختر الصنف من المخزون</label>
              <select id="invoice-item-select" onchange="autoFillInvoicePrice()" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-100 focus:outline-none focus:border-emerald-500"></select>
            </div>
            <div>
              <label class="block text-xs text-slate-300 font-semibold mb-1">الكمية المباعة</label>
              <input type="number" id="invoice-qty" value="1" min="1" oninput="calculateInvoiceTotal()" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-100 text-center focus:outline-none focus:border-emerald-500">
            </div>
            <div>
              <label class="block text-xs text-slate-300 font-semibold mb-1">سعر الوحدة (ج.م)</label>
              <input type="number" id="invoice-price" value="0" min="0" oninput="calculateInvoiceTotal()" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-100 text-center focus:outline-none focus:border-emerald-500">
            </div>
            <div>
              <label class="block text-xs text-slate-300 font-semibold mb-1">خصم نقدي (ج.م - اختياري)</label>
              <input type="number" id="invoice-discount" value="0" min="0" oninput="calculateInvoiceTotal()" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-100 text-center focus:outline-none focus:border-emerald-500">
            </div>

            <div class="sm:col-span-2 lg:col-span-4 pt-3 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3">
              <div class="text-xs">
                إجمالي الفاتورة المطلوب تحصيله: <span id="invoice-total-display" class="text-base font-black text-emerald-400 font-mono">0 ج.م</span>
              </div>
              <button type="submit" class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-6 py-2.5 rounded-xl text-xs flex items-center justify-center gap-2 shadow-lg transition">
                <i class="fa-solid fa-cloud-arrow-up"></i>
                <span>حفظ وترحيل الفاتورة والخزينة</span>
              </button>
            </div>
          </form>
        </div>

        <!-- 3. تبويب توريد وشراء -->
        <div id="tab-content-purchase" class="hidden space-y-4">
          <div>
            <h4 class="text-xs sm:text-sm font-bold text-white flex items-center gap-1.5">
              <i class="fa-solid fa-cart-flatbed text-indigo-400"></i>
              <span>تسجيل توريد / إيداع بضاعة في مخزن القسم</span>
            </h4>
            <p class="text-[11px] text-slate-400">زيادة رصيد الصنف المتوفر وتحديث تكلفة الشراء</p>
          </div>

          <form onsubmit="handlePurchaseSubmit(event)" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 bg-slate-900/60 p-4 rounded-xl border border-slate-800">
            <div>
              <label class="block text-xs text-slate-300 font-semibold mb-1">الصنف المورد</label>
              <select id="purchase-item-select" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-100 focus:outline-none focus:border-indigo-500"></select>
            </div>
            <div>
              <label class="block text-xs text-slate-300 font-semibold mb-1">الكمية المضافة للمخزن</label>
